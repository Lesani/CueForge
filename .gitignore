# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
dist/
build/

# Node (for HTML/JS tooling)
node_modules/

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Bundled ffmpeg binary (kept local; downloaded from the platform's publisher
# if absent). No extension on Linux, hence the bare glob.
vendor/ffmpeg/*

# Bundled yt-dlp binary (kept local; yt-dlp on PATH is the fallback)
vendor/yt-dlp/*

# PyInstaller spec regenerated per platform by build_exe.py (the Windows-named
# CueForge.spec is tracked; the per-platform ones are pure build output)
/CueForge-linux-*.spec

# CueForge working/runtime files
*.cueforge
*_work/
.cueforge_config.json

# Playwright / browser smoke artifacts
.playwright-mcp/
cueforge-*.png

# Local dev launcher (not committed)
run_dev.bat

# Claude Code local settings (the skills folder IS committed, on dev only)
.claude/settings.local.json

